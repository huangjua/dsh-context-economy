{
  "name": "@dsh-external/dsh-context-economy",
  "version": "0.0.1",
  "description": "Token-efficient project reading with symbol/import indexing, PageRank topology, and byte-level slicing for DSH",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-power-suite",
    "dsh-context",
    "context-compression",
    "token-saving",
    "pagerank"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2 || 0.1.2-alpha.3",
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/schemastery": "3.18.1 || 3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "check:dsh-contract": "node scripts/check-dsh-contract.mjs",
    "check": "npm run typecheck && npm run check:dsh-contract && npm run test && npm run pack:check"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
